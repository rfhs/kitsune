#!/bin/sh
set -e
set -u

if [ -z "${1:-}" ]; then
  printf "Please provide conference name\n"
  exit 1
fi
if [ -e "src/conferences/$(date +"%Y")${1}.h" ]; then
  printf "src/conferences/%s%s.h already exists, please remove it or pick a different name\n" "$(date +"%Y")" "${1}"
  exit 1
fi

# Five random bytes behind the fixed first one. od prints them as decimal
# numbers separated by spaces; set -- makes each one a positional argument.
get_mac() {
  # shellcheck disable=SC2046  # splitting od's output into 5 words is the point
  set -- $(od -An -N5 -tu1 /dev/urandom)
  printf '\{0xF2, 0x%02X, 0x%02X, 0x%02X, 0x%02X, 0x%02X\}\n' "$@"
}

get_uuid() {
  uuidgen | tr '[:lower:]' '[:upper:]'
}

sed -e "s#{0x00, 0x01, 0x02, 0x03, 0x04, 0x05}#$(get_mac)#" \
  -e "s#{0x00, 0x06, 0x07, 0x08, 0x09, 0x0a}#$(get_mac)#" \
  src/conferences/9999skel.h > "src/conferences/$(date +"%Y")${1}.h"
