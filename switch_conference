#!/bin/sh
set -e
set -u

# Ensure we have a conference name
if [ -n "${1:-}" ]; then
  conf="${1}"
else
  printf "Please provide conference name\n"
  exit 1
fi

# Check that every project has that conference before switching any of them
for challenge in bluetooth/iBeacon bluetooth/classic_discoverable wifi/wifi_ap_client zigbee/zigbee_coordinator; do
  if [ ! -e "${challenge}/src/conferences/${conf}.h" ]; then
    printf "%s/src/conferences/%s.h does not exist, unable to switch to this conference\n" "${challenge}" "${conf}"
    exit 1
  fi
done

for challenge in bluetooth/iBeacon bluetooth/classic_discoverable wifi/wifi_ap_client zigbee/zigbee_coordinator; do
  ln -snf "conferences/${conf}.h" "${challenge}/src/current_conf.h"
done
printf "Switched to %s\n" "${conf}"
