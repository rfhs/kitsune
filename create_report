#!/bin/bash
set -e
set -u

threewords() {
  if [ ! -r '/usr/share/dict/cracklib-words' ]; then
    printf 'Unable to find /usr/share/dict/cracklib-words\n'
    exit 1
  fi
  dictionary='/usr/share/dict/cracklib-words'
  shuf -n3 "${dictionary}" | tr '[:lower:]' '[:upper:]' | paste -sd ' ' | dos2unix
}

create_report() {
  printf "Formatting with conference name for %s... " "${conf}"
  sed -i \
    -e "/RFHS_CHALLENGE_NAME/{h; s/.*/printf -- '-\\n----------------------------------------------------------------\\nConference: %s\\n' \"${conf}\"/e; G;}" \
    "${conf}.txt"
  printf "complete\n"

  printf "Adding instructions..."
  sed -i -e "/FOX_KEYWORDS/{h; s/.*/printf -- '\n%s\n\n' \"\$(cat foxhunt_instructions.txt)\"/e; G;}" "${conf}.txt"
  printf "complete\n"

  printf "Seeding keys for %s... " "${conf}"
  # Put a three word flag where the instructions say FOXFLAG
  while IFS= read -r line; do
    case "${line}" in
      *FOXFLAG*) printf '%s\n' "${line%%FOXFLAG*}$(threewords)${line#*FOXFLAG}" ;;
      *) printf '%s\n' "${line}" ;;
    esac
  done < "${conf}.txt" > "${conf}.txt.seeded"
  mv "${conf}.txt.seeded" "${conf}.txt"
  printf "complete\n"

  sed -i '1iSet font to "Roboto Mono"' "${conf}.txt"

  printf "Generation Complete\n"
}

# Ensure we have a conference name
if [ -n "${1:-}" ]; then
  conf="${1}"
else
  printf "Please provide conference name\n"
  exit 1
fi
for challenge in bluetooth/iBeacon bluetooth/classic_discoverable wifi/wifi_ap_client zigbee/zigbee_coordinator non-kitsune-foxes/fm_fox; do
  pushd "${challenge}" > /dev/null 2>&1
  # The stubs in non-kitsune-foxes have no conferences, just one header
  header="src/conferences/${conf}.h"
  if [ ! -d src/conferences ]; then
    header="src/current_conf.h"
  fi
  # PAN_ID keeps its 0x so it matches what Kismet shows.
  # EXT_PAN_ID is usually defined as MAC_ADDR. sed keeps the last MAC_ADDR
  # line in its hold space and prints that in place of the literal text.
  grep -e 'RFHS_CHALLENGE_NAME\|FOX_KEYWORDS\|NAME\|UUID\|MAC_ADDR\|FSSID\|CHANNEL\|PAN_ID' "${header}" | \
    sed -e 's#{##' -e 's#}##' -e '/^#define PAN_ID /!s#0x##g' -e 's#, #:#g' -e 's#// ##' -e "s/#define //" \
      -e '/^MAC_ADDR /h' -e '/^EXT_PAN_ID MAC_ADDR$/{g; s/^MAC_ADDR/EXT_PAN_ID/;}' | tee -a "${OLDPWD}/${conf}.txt" > /dev/null 2>&1
  printf "complete\n"
  popd > /dev/null 2>&1
done
create_report
