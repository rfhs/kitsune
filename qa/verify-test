#!/bin/sh
# Check the verify scripts and their foxverify package: pyflakes over every
# Python file, then the unit tests. The tests need no hardware; the one that
# decodes a generated pcap with tshark is skipped where tshark is missing and
# runs in CI and in qa/in-ubuntu, where qa/setup installs it.
#
# Usage: qa/verify-test
# Needs python3, pyserial and pyflakes (Debian and Ubuntu: python3-serial
# python3-pyflakes), or run ./qa/in-ubuntu ./qa/verify-test.
set -e
set -u
cd "$(dirname -- "${0}")/.."
for module in serial pyflakes; do
  if ! python3 -c "import ${module}" 2> /dev/null; then
    printf 'python3 module %s not found. Run qa/setup, or ./qa/in-ubuntu ./qa/verify-test\n' "${module}"
    exit 1
  fi
done
printf 'pyflakes %s\n' "$(python3 -m pyflakes --version | head -n 1)"
python3 -m pyflakes foxverify bluetooth/*/verify wifi/*/verify zigbee/*/verify
printf 'pyflakes: no findings\n'
python3 -m unittest discover -s foxverify/tests -t .
