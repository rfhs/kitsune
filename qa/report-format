#!/bin/sh
# Generate the conference reports the way an organizer would and check
# every line of them. Needs the cracklib word list and dos2unix, see qa/setup.
set -e
set -u

cd "$(dirname -- "${0}")/.."

## The second report is for a conference rolled off the skel. Its files are
## removed before it is made, so make_conference_full can't refuse, and on
## exit, even after a failure. make_conference_full repoints every
## current_conf.h; a dangling one is pointed back at 9999demo.h.
conf="$(date +"%Y")qa-report-format"
cleanup() {
  rm -f -- ./*/*/src/conferences/"${conf}.h" "${conf}.txt"
  for link in ./*/*/src/current_conf.h; do
    if [ -L "${link}" ] && [ ! -e "${link}" ]; then
      ln -snf conferences/9999demo.h "${link}"
    fi
  done
}
trap cleanup EXIT
cleanup

## Report for 9999demo, the conference checked in to every project.
## The fm_fox stub has one header that is in every report.
rm -f 9999demo.txt
./create_report 9999demo
./qa/verify-report 9999demo.txt ./*/*/src/conferences/9999demo.h non-kitsune-foxes/fm_fox/src/current_conf.h

## Report for a conference just rolled off 9999skel
./make_conference_full qa-report-format
./qa/verify-report "${conf}.txt" ./*/*/src/conferences/"${conf}.h" non-kitsune-foxes/fm_fox/src/current_conf.h

## The Wi-Fi make_conference gives every block its own PSK of 63 letters and
## digits, so the rolled header must hold as many distinct PSKs of that form
## as the skel has PSK lines. A placeholder left behind or one passphrase
## shared by every block fails here.
wifi_skel="wifi/wifi_ap_client/src/conferences/9999skel.h"
wifi_conf="wifi/wifi_ap_client/src/conferences/${conf}.h"
skel_psks="$(grep -c '^#define PSK ' "${wifi_skel}")"
rolled_psks="$(sort -u "${wifi_conf}" | grep -cE '^#define PSK "[A-Za-z0-9]{63}"$' || true)"
if [ "${rolled_psks}" -ne "${skel_psks}" ]; then
  printf 'FAIL: %s has %s distinct 63-character PSKs, %s has %s PSK lines\n' "${wifi_conf}" "${rolled_psks}" "${wifi_skel}" "${skel_psks}"
  exit 1
fi
printf '%s: %s distinct 63-character PSKs\n' "${wifi_conf}" "${rolled_psks}"
