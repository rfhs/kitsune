#!/bin/sh
set -e
set -u

if [ -z "${1:-}" ]; then
  printf "Please provide conference name\n"
  exit 1
fi
if [ -e "src/conferences/$(date +"%Y")${1}.h" ]; then
  printf "src/conferences/%s%s.h already exists, please remove it or pick a different name\n" "$(date +"%Y")" "${1}"
  exit 1
fi

# All six bytes are random. The first byte is then forced to have bit 0
# clear, so the address is unicast (I/G), and bit 1 set, so it is locally
# administered and never collides with a vendor's assigned block. That
# leaves it even and nonzero, so the address can never be all zeros and
# every roll is a valid Wi-Fi MAC. od prints the bytes as decimal numbers
# separated by spaces; set -- makes each one a positional argument.
get_mac() {
  # shellcheck disable=SC2046  # splitting od's output into 6 words is the point
  set -- $(od -An -N6 -tu1 /dev/urandom)
  printf '\{0x%02X, 0x%02X, 0x%02X, 0x%02X, 0x%02X, 0x%02X\}\n' $(( ($1 & 0xFC) | 0x02 )) "$2" "$3" "$4" "$5" "$6"
}

get_uuid() {
  uuidgen | tr '[:lower:]' '[:upper:]'
}

sed -e "s#{0x00, 0x01, 0x02, 0x03, 0x04, 0x05}#$(get_mac)#" \
  -e "s#{0x00, 0x06, 0x07, 0x08, 0x09, 0x0a}#$(get_mac)#" \
  -e "s#{0x00, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f}#$(get_mac)#" \
  -e "s#{0x00, 0x10, 0x11, 0x12, 0x13, 0x14}#$(get_mac)#" \
  -e "s#{0x00, 0x15, 0x16, 0x17, 0x18, 0x19}#$(get_mac)#" \
  -e "s#{0x00, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e}#$(get_mac)#" \
  src/conferences/9999skel.h > "src/conferences/$(date +"%Y")${1}.h"
